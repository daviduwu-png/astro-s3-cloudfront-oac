---
import { experienceData } from '../../../data/experience.data';
import SectionHeader from '../../ui/SectionHeader.astro';
import Badge from '../../ui/Badge.astro';
import Icon from '../../ui/Icon.astro';
---

<section id="experiencia" class="section">
  <div class="container">
    <SectionHeader
      eyebrow="Trayectoria Profesional"
      title="Experiencia en Ingeniería de Software"
      subtitle="Recorrido liderando e implementando soluciones web para empresas tecnológicas y equipos distribuidos."
      variant="purple"
    />

    <div class="timeline">
      {
        experienceData.map((item, idx) => (
          <article class="card exp-card reveal" style={`--delay: ${idx * 120}ms;`}>
            <div class="exp-header">
              <div>
                <span class="exp-period">{item.period}</span>
                <h3>{item.role}</h3>
                <p class="exp-company">{item.company}</p>
              </div>
              <Badge variant="blue">{item.type}</Badge>
            </div>

            <p class="exp-desc">{item.description}</p>

            <ul class="exp-highlights">
              {item.highlights.map((hl) => (
                <li>
                  <Icon name="arrow-right" size={14} class="hl-icon" />
                  <span>{hl}</span>
                </li>
              ))}
            </ul>

            <div class="exp-tech">
              {item.tech.map((t) => (
                <code>{t}</code>
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .timeline {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .exp-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .exp-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
  }

  .exp-period {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--purple-light);
  }

  .exp-header h3 {
    font-size: 1.2rem;
    margin-top: 0.2rem;
    color: var(--text-primary);
  }

  .exp-company {
    color: var(--blue-light);
    font-size: 0.9rem;
    font-weight: 500;
  }

  .exp-desc {
    color: var(--text-secondary);
    font-size: 0.93rem;
  }

  .exp-highlights {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .exp-highlights li {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 0.88rem;
    color: var(--text-primary);
  }

  .hl-icon {
    color: var(--purple-light);
    margin-top: 0.25rem;
  }

  .exp-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: auto;
    padding-top: 0.5rem;
  }

  .exp-tech code {
    font-size: 0.75rem;
    padding: 0.2rem 0.55rem;
    border-radius: 4px;
    background: var(--bg-secondary);
    color: var(--blue-light);
    border: 1px solid var(--border-subtle);
  }

  @media (max-width: 900px) {
    .timeline {
      grid-template-columns: 1fr;
    }
  }
</style>
