---
import { projectsData } from '../../../data/projects.data';
import SectionHeader from '../../ui/SectionHeader.astro';
import Badge from '../../ui/Badge.astro';
import Icon from '../../ui/Icon.astro';
---

<section id="proyectos" class="section">
  <div class="container">
    <SectionHeader
      eyebrow="Portafolio de Proyectos"
      title="Aplicaciones & Productos Destacados"
      subtitle="Selección de sistemas web, plataformas SaaS y aplicaciones de comercio electrónico desarrolladas para producción."
      variant="purple"
    />

    <div class="grid-2">
      {
        projectsData.map((project, idx) => (
          <article class="card project-card reveal" style={`--delay: ${idx * 100}ms;`}>
            <div class="project-top">
              <Badge variant={project.featured ? 'purple' : 'blue'}>
                <Icon name="layers" size={13} />
                <span>{project.category}</span>
              </Badge>
              <span class="project-metrics">{project.metrics}</span>
            </div>

            <h3 class="project-title">{project.title}</h3>
            <p class="project-desc">{project.description}</p>

            <div class="arch-flow">
              <span class="arch-label">Stack Principal:</span>
              <code>{project.stackSummary}</code>
            </div>

            <div class="project-footer">
              <div class="project-tags">
                {project.tags.map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
              <a href={project.repoUrl} target="_blank" rel="noreferrer" class="project-link">
                <span>Código</span>
                <Icon name="external" size={14} />
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.1rem;
  }

  .project-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .project-metrics {
    font-size: 0.78rem;
    font-family: var(--font-mono);
    color: var(--blue-light);
  }

  .project-title {
    font-size: 1.3rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--text-primary);
    transition: color 0.22s ease;
  }

  .project-card:hover .project-title {
    color: var(--purple-light);
  }

  .project-desc {
    color: var(--text-secondary);
    font-size: 0.94rem;
  }

  .arch-flow {
    background: var(--bg-code);
    padding: 0.65rem 0.9rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-subtle);
    font-size: 0.8rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .arch-label {
    color: var(--text-muted);
    font-weight: 600;
  }

  .arch-flow code {
    color: var(--purple-light);
  }

  .project-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 0.25rem;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .tag {
    font-size: 0.75rem;
    font-family: var(--font-mono);
    padding: 0.22rem 0.6rem;
    border-radius: 6px;
    background: var(--bg-secondary);
    color: var(--text-secondary);
    border: 1px solid var(--border-subtle);
  }

  .project-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--blue-light);
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .project-link:hover {
    color: var(--purple-light);
    transform: translateX(2px);
  }
</style>
